# Идентификаторы боевого развёртывания. Скопируй в deploy.env и впиши свои:
#
#     cp deploy.env.example deploy.env && $EDITOR deploy.env
#
# Сам deploy.env в гит НЕ попадает (.gitignore). Пока эти строки стояли прямо
# в скриптах, репозиторий раздавал карту инфраструктуры: какой проект, какое
# окружение, какой сервис и каким ключом к нему ходит крон. Ключ и вход в
# Railway это, конечно, не заменяет — но и подсказывать, куда стучаться,
# публичному репозиторию незачем.

# Путь к CLI Railway (npm i -g @railway/cli)
RAILWAY_BIN="$HOME/.npm-global/bin/railway"

# Проект и окружение: railway status покажет и то, и другое
RAILWAY_PROJECT="00000000-0000-0000-0000-000000000000"
RAILWAY_ENVIRONMENT="production"

# Два сервиса: база и приложение. Дампы и SQL идут в базу, сид — в приложение
# (сид это код приложения, а не запрос к базе).
RAILWAY_SERVICE_DB="Postgres"
RAILWAY_SERVICE_APP="graph"

# Ключ для `railway ssh`. Без пароля: у cron нет ssh-agent.
RAILWAY_SSH_KEY="$HOME/.ssh/id_ed25519"

# Внешний адрес инстанса — по нему seed-prod.sh проверяет результат снаружи
PUBLIC_URL="https://example.invalid"
