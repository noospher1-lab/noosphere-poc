# Образец окружения. Скопировать в .env для локального запуска; на Railway те
# же ключи задаются в Variables сервиса. Реальные значения сюда НЕ писать —
# .env в .gitignore, .env.example коммитится.

# Общий ключ Anthropic: с него платят все аккаунты, каждому нарезан грант
# balance_usd (см. decisions/shared-key-account-budget.md).
ANTHROPIC_API_KEY=sk-ant-...

# Локально — свой Postgres. На Railway подставляется плагином Postgres,
# вручную задавать не нужно: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://noosphere:noosphere@localhost/noosphere

# Бэрер для админ-просмотра диалогов (чужие транскрипты!). Длинная случайная
# строка, на проде обязателен и отличается от локального.
ADMIN_TOKEN=

# Origin, по которому сервер строит внешние ссылки (сброс пароля). Без него
# тестер получит ссылку на localhost.
PUBLIC_URL=http://localhost:8000

# Дев-инструменты: reset, персоны, ручные PoI-приоры, сырые рёбра.
# На проде ТОЛЬКО 0 — иначе любой сможет снести базу.
DEV_TOOLS=1

# Secure-флаг сессионной куки. 1 везде, где есть HTTPS (Railway — да).
COOKIE_SECURE=0

# Грант новому аккаунту, $. И потолок LLM-запросов в минуту на аккаунт.
DEFAULT_BALANCE_USD=3
LLM_BUDGET_PER_MIN=10
LOGIN_TRIES_PER_MIN=10

# ОБЩИЙ потолок трат по ключу инстанса, $. Грант выше ограничивает одного
# тестера, этот кран — сумму на карте. Пусто/0 = крана нет (локальный стенд).
# На проде задавать ОБЯЗАТЕЛЬНО, по размеру пополнения ключа.
# Расход смотреть: GET /api/dev/llm-budget с заголовком X-Admin-Token.
NOOSPHERE_LLM_CAP_USD=

# Предохранитель db.wipe(): на проде НЕ задавать вообще.
# NOOSPHERE_ALLOW_WIPE=1

# ── Ниже: переменные, которые код читает, а образец до сих пор умалчивал.
# В публичном репозитории .env.example — это инструкция по запуску: то, чего
# в нём нет, новый человек найдёт только грепом по исходникам.

# Какие разделы стенд НЕ показывает (vault: decisions/2026-09-21-participation-points).
# Закрывает вход, а не удаляет код: страница и эндпоинты продолжают отвечать.
# Ключи: catalog, values, alignment, interventions, workspace, public_profiles,
# stats, trainer, votes, points, profile. Пусто = показывать всё.
NOOSPHERE_HIDE=trainer,votes,stats,public_profiles

# Нужен ли код приглашения при регистрации. 1 — закрытый тест (умолчание),
# 0 — открытая дверь (тогда см. drafts/before-open-registration.md).
INVITE_REQUIRED=1
# Грант тому, кто пришёл по коду, $. Пусто = как DEFAULT_BALANCE_USD.
INVITE_BALANCE_USD=

# Редакция условий, под которой человек расписался. Меняется, когда меняется
# то, о чём он соглашался: принявшие прошлую увидят уведомление при входе.
TERMS_VERSION=2026-09-10

# Логины администраторов через запятую (умолчание — root). Не секрет:
# админ-аккаунт может, например, удалить чужое пустое голосование.
ADMIN_USERNAMES=root
# Адрес, на который уходят служебные письма (заявки на пополнение счёта).
ADMIN_EMAIL=

# Почта через Resend: ключ — секрет, сюда пишется только имя переменной.
# Без ключа письма не уходят, а печатаются в лог — локально этого хватает.
RESEND_API_KEY=
MAIL_FROM=Noosphere <noreply@example.invalid>
MAIL_REPLY_TO=

# Векторы для поиска похожих проблем поверх языков (fastembed, локальная
# модель, без ключа). 0 — выключить (тесты подставляют свои векторы).
NOOSPHERE_EMBED=1
# Куда fastembed кладёт модель. Пусто — его умолчание.
NOOSPHERE_EMBED_CACHE=

# Разговоры с ИИ (разбор, компаньон, precheck) пишутся в companion_log —
# этот файл дублирует их на диск. Пусто = только в базу.
COMPANION_LOG=
# Потолок ходов в одном разговоре с компаньоном.
COMPANION_MAX_TURNS=25
