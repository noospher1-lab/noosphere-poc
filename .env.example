# Образец окружения. Скопировать в .env для локального запуска; на Railway те
# же ключи задаются в Variables сервиса. Реальные значения сюда НЕ писать —
# .env в .gitignore, .env.example коммитится.

# Общий ключ Anthropic: с него платят все аккаунты, каждому нарезан грант
# balance_usd (см. decisions/shared-key-account-budget.md).
ANTHROPIC_API_KEY=sk-ant-...

# Локально — свой Postgres. На Railway подставляется плагином Postgres,
# вручную задавать не нужно: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://noosphere:noosphere@localhost/noosphere

# Бэрер для админ-просмотра диалогов (чужие транскрипты!). Длинная случайная
# строка, на проде обязателен и отличается от локального.
ADMIN_TOKEN=

# Origin, по которому сервер строит внешние ссылки (сброс пароля). Без него
# тестер получит ссылку на localhost.
PUBLIC_URL=http://localhost:8000

# Дев-инструменты: reset, персоны, ручные PoI-приоры, сырые рёбра.
# На проде ТОЛЬКО 0 — иначе любой сможет снести базу.
DEV_TOOLS=1

# Secure-флаг сессионной куки. 1 везде, где есть HTTPS (Railway — да).
COOKIE_SECURE=0

# Грант новому аккаунту, $. И потолок LLM-запросов в минуту на аккаунт.
DEFAULT_BALANCE_USD=3
LLM_BUDGET_PER_MIN=10
LOGIN_TRIES_PER_MIN=10

# Предохранитель db.wipe(): на проде НЕ задавать вообще.
# NOOSPHERE_ALLOW_WIPE=1
